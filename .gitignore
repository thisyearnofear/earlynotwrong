# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.ops.md
# Allow committed template files — values are placeholders, not secrets.
!.env.example
!agent/.env.example

# vercel
.vercel

#typescript
*.tsbuildinfo
next-env.d.ts

.junie
.qoder/
.claude/

# agent runtime state (contains live wallet portfolio/positions)
agent/data/
agent/dist/
agent/data/state.json*.bak-*

# Aleo / Leo
/aleo/build/
/aleo/inputs/
/aleo/outputs/
/aleo/imports/
*.avm
.zencoder
.zenflow

# agent typedoc output
agent/docs/api/
