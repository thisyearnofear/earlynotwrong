# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — any package root (agent/, examples/*, videos/*, etc.)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.ops.md
# Allow committed template files — values are placeholders, not secrets.
!.env.example
!agent/.env.example

# vercel
.vercel

#typescript
*.tsbuildinfo
next-env.d.ts

.junie
.qoder/
.claude/

# agent runtime state (contains live wallet portfolio/positions)
agent/data/
agent/dist/
agent/data/state.json*.bak-*

# Aleo / Leo
/aleo/build/
/aleo/inputs/
/aleo/outputs/
/aleo/imports/
*.avm
.zencoder
.zenflow

# agent typedoc output
agent/docs/api/

# HyperFrames video projects and generated media.
# Video directories are local build/source workspaces and are not committed.
videos/

# Auto-generated boilerplate from `hyperframes init` / `hyperframes capture`
# — identical generic docs, not project-specific.
videos/*/AGENTS.md
videos/*/CLAUDE.md
videos/*/capture/AGENTS.md
videos/*/capture/CLAUDE.md
videos/*/capture/.cursorrules

# HyperFrames video project (video/ — singular, buildathon demo)
# Entire directory ignored: contains rendered MP4s, audio assets, screenshots,
# and auto-generated HyperFrames boilerplate. Regeneratable from source.
video/

# Stray HyperFrames catalog blocks installed at repo root by mistake.
compositions/

# Local agent session telemetry — unrelated to repo contents.
.kimchi/

# SigNoz Foundry generated deployment artifacts
/pours/
casting.yaml.lock

# Rendered demo binaries — large, regeneratable, host externally (YouTube /
# Vercel / asciinema) and link from the README rather than committing.
docs/demo-*.mp4
docs/demo-*.gif
docs/demo-*.webm
demo.cast

# Reference / example subprojects (npm install locally; secrets stay local)
examples/**/.env
examples/**/.env.*
!examples/**/.env.example
