# Agent runtime environment variables.
# Copy to .env (gitignored) and fill in. Production values live on the VPS.

# ─── TWAK (BSC trading execution) ─────────────────────────────────────────
TWAK_ACCESS_ID=
TWAK_HMAC_SECRET=
# Wallet password for the TWAK agent wallet. Required for signing swaps.
# Use `twak wallet keychain save` to store it in the OS keychain instead.
TWAK_WALLET_PASSWORD=
# 0x address of the BSC trading wallet (optional override). If unset, the agent
# reads the live address from `twak wallet address --chain=bsc`.
AGENT_WALLET_KEY=
# Set TWAK_TESTNET=1 to point swaps at BSC Testnet. Defaults to mainnet (live BNB Hack PnL window).
# TWAK_TESTNET=1

# ─── SoDEX testnet (on-chain orderbook execution, Buildathon bonus) ───────
# API key for signing SoDEX spot trading actions. Generates EIP-712 typed
# signatures for market orders on ValueChain testnet (chainId 138565).
# The private key's corresponding EVM address must be registered as an API
# key via the SoDEX addAPIKey contract call (one-time setup on testnet).
SODEX_API_KEY_PRIVATE=           # 32-byte hex private key (0x...), EIP-712 signing
# Optional: override the API key name (default: enw-agent)
# SODEX_API_KEY_NAME=
# Optional: override the base URL (default: testnet)
# SODEX_BASE_URL=

# ─── SoSoValue API (on-chain financial data, Buildathon integration) ───────
# Get your API key: https://sosovalue-1.gitbook.io/sosovalue-api-doc
# Required for the SoSoValue Buildathon submission. Used alongside CMC:
# SoSoValue token prices preferred, CMC fills regime data (Fear & Greed,
# funding rates) gaps.
SOSOVALUE_API_KEY=

# ─── CMC Agent Hub (market data fallback) ─────────────────────────────────
CMC_API_KEY=

# ─── NodeReal MegaNode + CoinGecko (holder counts, on-chain reads) ───────
NODEREAL_API_KEY=
COINGECKO_API_KEY=

# ─── Mantle ERC-8004 anchoring ────────────────────────────────────────────
# Authorized operator key for MantleConvictionRegistry.anchorConviction.
MANTLE_OPERATOR_KEY=

# ─── Casper Testnet anchoring (Casper Buildathon) ─────────────────────────
# Free-tier token from https://cspr.cloud. Used as the `Authorization` header
# for the cspr.cloud RPC fallback endpoint. The primary RPC
# (node.testnet.casper.network) needs no auth — this token is only used when
# the public node is unreachable and we fall back to cspr.cloud.
CSPR_CLOUD_TOKEN=
# Absolute path to the operator's Ed25519 private key (.pem from Casper Wallet export).
CASPER_OPERATOR_PEM=
# Set after running `node scripts/casper-deploy.mjs` — the installed contract hash.
# Until set, the Casper adapter reports `isAvailable() = false` and the orchestrator skips it.
CASPER_REGISTRY_HASH=
# Override algorithm if you use SECP256K1 instead of Ed25519. Default Ed25519.
# CASPER_OPERATOR_ALGORITHM=secp256k1

# ─── CROO Agent Protocol (CAP) — A2A commerce layer ─────────────────────
# Optional: override the default CROO API endpoints. If CROO_SDK_KEY is set,
# the agent connects to the CROO network and advertises the reputation
# services defined in agent/src/cap/pricing.ts.
# CROO_API_URL=https://api.croo.network
# CROO_WS_URL=wss://api.croo.network/ws
CROO_SDK_KEY=

# CROO Store registers services with an internal UUID. Set this to the UUID shown
# on your Store service page so CAP negotiations map to signals-live.
# Example: CROO_SIGNALS_LIVE_SERVICE_UUID=3da733af-bc0f-492e-9117-d47b055e4fe1
# Or use a JSON map: CROO_SERVICE_UUID_MAP='{"<uuid>":"signals-live"}'
CROO_SIGNALS_LIVE_SERVICE_UUID=

# CROO wallet used for Agent Store whitelist access and USDC receipt.
# Generate with: node agent/scripts/generate-croo-wallet.mjs
CROO_WALLET_ADDRESS=
CROO_WALLET_KEY=

# ─── MCP + x402 reputation marketplace (Casper Buildathon) ────────────────
# Paywall config for paid MCP tools. Both values are public on-chain
# identifiers — fine to commit defaults; override per-deployment if needed.
#
# CASPER_X402_ASSET_HASH: the Cep18x402 token (the cspr.cloud testnet's
# canonical x402 CEP-18 wrapper for CSPR — no deploy needed, just point at it).
CASPER_X402_ASSET_HASH=9824d60dc3a5c44a20b9fd260a412437933835b52fc683d8ae36e4ec2114843e
# CASPER_PAYTO_ACCOUNT_HASH: the account hash (NOT public key) that receives
# x402 settlements. Derive from your operator: `casper-client account-hash`
# or query `state_get_entity` with the public key.
CASPER_PAYTO_ACCOUNT_HASH=
# Optional metadata overrides — the defaults match the cspr.cloud testnet
# Cep18x402 token, so you only need to set these if you point at a different
# CEP-18 instance.
# CASPER_X402_TOKEN_NAME=Cep18x402
# CASPER_X402_TOKEN_DECIMALS=2
# CASPER_X402_TOKEN_SYMBOL=CSPR

# ─── Aleo voucher sign service ────────────────────────────────────────────
# The agent hosts /aleo/sign-voucher (HMAC-authed) so ALEO_PRIVATE_KEY never
# touches Vercel. Vercel's /api/aleo/rebate route calls this endpoint to
# get a signed voucher, which the client then submits on Aleo Testnet.
ALEO_PRIVATE_KEY=               # treasury wallet's Aleo private key
ALEO_ADDRESS=                   # treasury wallet's Aleo address (must match
                                # the hardcoded address in aleo/src/main.leo)
ALEO_NETWORK=testnet            # was "testnet3"; Aleo retired that name
ALEO_SIGN_SERVICE_HMAC_SECRET=  # MUST match the value on Vercel; generate
                                # with: openssl rand -hex 32

# ─── Delphi information markets (Gensyn Agent Arena, optional) ──────────────
# Master switch for the prediction-market surface (agent/lib/delphi/,
# separate pm2 process). Off by default until the competition wallet is
# registered + funded. See docs/DELPHI_AGENT_ARENA.md.
DELPHI_ENABLED=0
# "competition-testnet" during the Agent Arena (Aug 10-24), "mainnet" later.
DELPHI_NETWORK=competition-testnet
# REST read key — generate at https://delphi-api-access.gensyn.ai/
DELPHI_API_ACCESS_KEY=
# Fresh, competition-only keypair (0x...). Registered on DoraHacks as our
# leaderboard identity. Never the TWAK or Casper operator key.
DELPHI_WALLET_PRIVATE_KEY=

# ─── OpenTelemetry (SigNoz observability — optional) ─────────────────────
# Export traces + metrics when SigNoz (or any OTLP collector) is running.
# See docs/observability/README.md and casting.yaml at repo root.
# OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=early-not-wrong-agent

# ─── Telegram (optional alerts) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── LLM providers (conviction jury + market narrative + Delphi forecaster) ──
# Provider priority (free-first): Vercel AI Gateway > OpenRouter > OpenAI >
# Anthropic > template (no key). During the Aug 2026 promo, zai/glm-5.2 is
# free on the Vercel AI Gateway — one key unlocks inference AND Exa web
# search for the Delphi forecaster (see docs/DELPHI_AGENT_ARENA.md).
# The gateway rejects response_format; reasoning.effort is sent instead
# (GLM 5.2 is a reasoning model — without the cap, reasoning tokens eat the
# completion budget and content comes back empty).
VERCEL_AI_GATEWAY_API_KEY=
# VERCEL_GATEWAY_DELPHI_MODEL=zai/glm-5.2
# VERCEL_GATEWAY_JURY_MODEL=zai/glm-5.2
# First UTC day the gateway promo is OVER (ladder drops it automatically).
# Default: 2026-08-28 (day after GLM 5.2 free window ends 2026-08-27).
# Set to "never" to keep the gateway on the ladder indefinitely.
# VERCEL_GATEWAY_PROMO_ENDS=2026-08-28
OPENROUTER_API_KEY=
# OpenRouter models are pinned to explicit `:free` IDs by default — the
# account carries paid credits, and openrouter/auto would route to paid
# models. Only override with another `:free` model (or accept billing).
# OPENROUTER_JURY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_NARRATIVE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_DELPHI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Free Qwen3.8-27B endpoints (added after the Vercel gateway credit ran out).
# hf-qwen: public keyless HF Inference endpoint (~30 req/min/IP, temporary —
#   "retired after the launch buzz"). Any value opts in, including "none".
# HF_QWEN_API_KEY=none
# HF_QWEN_ENDPOINT_URL=https://g9hnto0u7lvbu837.us-east-2.aws.endpoints.huggingface.cloud/v1/chat/completions
# HF_QWEN_DELPHI_MODEL=Qwen/Qwen3.8-27B
# orcarouter: $0 self-hosted Qwen3.8-27B (rate-limited, slower).
# ORCAROUTER_API_KEY=
# ORCAROUTER_DELPHI_MODEL=qwen/qwen3.8-27b-free

# ─── Delphi Tier 4 — adversarial pre-entry verifier ──────────────────────────
# The verifier cross-examines each candidate ENTRY (after the edge gate) with
# a different model family than the one that produced the estimate. Optionally
# dedicate ONE ladder provider to this role — e.g. a paid key on a different
# family than the free Qwen forecaster (different family = real cross-
# examination, not correlated blind spots). Values: vercel-gateway |
# openrouter | hf-qwen | orcarouter | openai | anthropic. When unset, the
# verifier rearranges the existing ladder cross-family-first; when no
# alternative family is keyed it degrades to same-family verification.
# DELPHI_VERIFIER_PROVIDER=openai

# ─── Delphi web-search rungs (briefings for the forecaster prompt) ────────────
# Rung order: firecrawl > parallel > exa (Vercel gateway). The first two are
# keyless free tiers — set the API key only to raise their rate limits. Exa
# rides the Vercel AI Gateway promo and is the fallback rung (see
# docs/DELPHI_AGENT_ARENA.md). Each rung has its own circuit breaker.
# FIRECRAWL_API_KEY=
# PARALLEL_API_KEY=
# Fallback providers (checked only if no higher-priority key is set):
# OPENAI_API_KEY=
# OPENAI_JURY_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_JURY_MODEL=claude-3-haiku-20240307
