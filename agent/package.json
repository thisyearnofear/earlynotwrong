{
  "name": "early-not-wrong-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Conviction-native trading agent for BNB Hack — contrarian entries, held through drawdown, capped only when the thesis breaks",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backtest": "tsx scripts/run-backtest.ts",
    "docs": "typedoc",
    "docs:serve": "npx serve docs/api",
    "dev": "tsx watch src/index.ts",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@croo-network/sdk": "^0.2.1",
    "@hono/node-server": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/hashes": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@provablehq/sdk": "^0.10.5",
    "casper-js-sdk": "^5.0.12",
    "conviction-core": "file:../packages/conviction-core",
    "hono": "^4.12.26",
    "typescript": "^5.7.0",
    "viem": "^2.52.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "vitest": "^4.1.9"
  }
}
