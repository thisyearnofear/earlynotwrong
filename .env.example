# ─── Agent dashboard (live status proxy) ───────────────────────────────────
# Host/port of the TWAK agent HTTP server (defaults: localhost:3000 via proxy)
# NEXT_PUBLIC_AGENT_HOST=http://144.202.117.160
# NEXT_PUBLIC_AGENT_PORT=31777

# SigNoz UI base URL — enables "Open SigNoz" + trace deep links on /agent
# NEXT_PUBLIC_SIGNOZ_URL=http://localhost:8080

# Base URL for share links and OG images
NEXT_PUBLIC_APP_URL=https://earlynotwrong.vercel.app/

# Ethos API Configuration
NEXT_PUBLIC_ETHOS_API_URL=https://api.ethos.network/api/v2
NEXT_PUBLIC_ETHOS_CLIENT_ID=early-not-wrong

# Wallet Connect Project ID (for RainbowKit/Wagmi if used)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# RPC URLs (Optional - defaults usually work for dev)
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=

# Server-side API Keys (not exposed to client)
HELIUS_API_KEY=
ALCHEMY_API_KEY=
BIRDEYE_API_KEY=
COINGECKO_API_KEY=
JUPITER_API_KEY=
NEYNAR_API_KEY=

# Helius Webhook Auth (optional - for securing webhook endpoint)
HELIUS_WEBHOOK_AUTH=

# Vercel KV (Redis) - for persistent caching (optional)
# Get these from: https://vercel.com/dashboard/stores
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Postgres (Neon) - for storing analyses & watchlist
# Connect via: Vercel Dashboard > Storage > Connect to Project
# These are auto-injected when connected
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Notification System (Phase 3)
# Resend for transactional emails - https://resend.com
RESEND_API_KEY=
FROM_EMAIL=alerts@earlynotwrong.com

# Telegram Bot for alerts - create via @BotFather
TELEGRAM_BOT_TOKEN=

# Cron endpoint protection (set a random secret)
CRON_SECRET=

# FairScale API (Solana trust scoring)
FAIRSCALE_API_KEY=

# Memory Protocol (Cross-chain identity graph)
# Get API key at: https://memoryproto.co/dashboard
MEMORY_API_KEY=

# Farcaster Mini App Configuration
# Generate account association at: https://warpcast.com/~/developers/mini-apps
# These sign your domain to prove ownership to your Farcaster account
FARCASTER_HEADER=
FARCASTER_PAYLOAD=
FARCASTER_SIGNATURE=

# ─── Aleo ───────────────────────────────────────────────────────────────────
#
# IMPORTANT — security boundary:
# ALEO_PRIVATE_KEY is NOT set on Vercel anymore. Voucher signing moved to
# the VPS (agent/src/aleo/sign-service.ts) so the key never enters the
# Next.js bundle's process memory. On Vercel, you only need the two
# SIGN_SERVICE_* values below; the key + ADDRESS + NETWORK live in the
# VPS .env (see agent/.env.example).
#
# Required on Vercel:
ALEO_SIGN_SERVICE_URL=                  # e.g. http://144.202.117.160:31777
ALEO_SIGN_SERVICE_HMAC_SECRET=          # MUST match the value on the VPS

# Optional — left here for any other Aleo flows you want to add Vercel-side
# (the wallet-adaptor packages are client-only and don't need a private key
# server-side).
# ALEO_MNEMONIC=
# ALEO_PRIVATE_KEY=                     # DO NOT SET ON VERCEL (use the VPS)
# ALEO_ADDRESS=
ALEO_NETWORK=testnet                    # was "testnet3" — Aleo retired that name